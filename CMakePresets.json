{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "native-debug",
            "displayName": "Native Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "native-release",
            "displayName": "Native Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/native-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x86-cross-debug",
            "displayName": "x86 Cross Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/x86-cross-debug",
            "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-clang-x86_64-al2023.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
            }
        },
        {
            "name": "x86-cross-release",
            "displayName": "x86 Cross Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/x86-cross-release",
            "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-clang-x86_64-al2023.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE": "PRE_TEST"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-debug",
            "configurePreset": "native-debug"
        },
        {
            "name": "native-release",
            "configurePreset": "native-release"
        },
        {
            "name": "x86-cross-debug",
            "configurePreset": "x86-cross-debug"
        },
        {
            "name": "x86-cross-release",
            "configurePreset": "x86-cross-release"
        }
    ]
}
