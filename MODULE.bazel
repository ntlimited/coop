module(name = "coop", version = "0.1.0")

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "llvm", version = "0.6.1")
bazel_dep(name = "liburing", version = "2.14.bcr.2")
bazel_dep(name = "spdlog", version = "1.16.0")
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")
bazel_dep(name = "curl", version = "8.12.0.bcr.2")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "google_benchmark", version = "1.9.1")

# Fetched LLVM, libc++, Linux headers, and glibc ABI stubs: no client /usr sysroot.
# Register both native CI architectures; execution settings stay in the user's rc.
toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
toolchain.exec(arch = "x86_64", os = "linux")
toolchain.exec(arch = "aarch64", os = "linux")
toolchain.target(arch = "x86_64", os = "linux")
toolchain.target(arch = "aarch64", os = "linux")
use_repo(toolchain, "llvm_toolchains")
register_toolchains("@llvm_toolchains//:all")
